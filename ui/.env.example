# demo keeps the citizen flow local and does not require a wallet, a relayer,
# a contract, or a proof server. It never creates a receipt.
VITE_APP_MODE=demo

VITE_MIDNIGHT_NETWORK=preview

# Written by `npm run deploy:preview`.
VITE_MIDNIGHT_CONTRACT_ADDRESS=

# --- Sponsored relayer (the default civic path) -----------------------------
# With this set, the citizen needs no wallet: the browser proves the vote
# locally and the relayer pays the fee and submits it. Leave empty to fall
# back to the DApp Connector (Lace) path instead.
VITE_RELAYER_URL=http://localhost:8790

# Required whenever the relayer path is used: with no wallet in the flow there
# is nothing to delegate proving to, so the browser needs its own proof server.
#
# PRIVACY: a proof server sees the witness — the voter secret and the choice.
# Keep this on your own machine. Never point it at someone else's host.
VITE_MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300

VITE_MIDNIGHT_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
VITE_MIDNIGHT_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws

# Passport profile bridge and canonical explorer base.
VITE_PASSPORT_ORIGIN=https://midnightpassport.com
VITE_MIDNIGHT_EXPLORER_BASE_URL=https://explorer.preview.midnight.network/tx
