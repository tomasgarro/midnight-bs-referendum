# Relayer wallet seed: 64 hex characters (32 bytes).
#
# This key pays the network fee for every vote. Generate it yourself and keep
# it out of git — relayer/.env is gitignored. Never paste it into a chat, an
# issue, or a commit.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Then fund the resulting address with Preview NIGHT and register it for DUST:
#
#   npm run address --workspace midnight-referendum-relayer
#
RELAYER_SEED=

# Midnight Preview infrastructure. Defaults match the public Preview services.
RELAYER_NETWORK_ID=preview
RELAYER_INDEXER_HTTP_URL=https://indexer.preview.midnight.network/api/v4/graphql
RELAYER_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws
RELAYER_NODE_URL=wss://rpc.preview.midnight.network

# The relayer proves its own balancing transaction here.
RELAYER_PROOF_SERVER_URL=http://localhost:6300

# Loopback only. Exposing this without auth lets anyone spend the relayer's DUST.
RELAYER_HOST=127.0.0.1
RELAYER_PORT=8790
RELAYER_ALLOWED_ORIGINS=http://localhost:4173
