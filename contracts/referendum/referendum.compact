pragma language_version 0.23;

import CompactStandardLibrary;

export enum Choice {
  YES,
  NO,
  ABSTAIN,
}

export enum Phase {
  COMMIT,
  REVEAL,
  FINALIZED,
}

// Role keys are committed during deployment. The corresponding secrets are
// supplied as witnesses by the issuer and organizer applications.
export sealed ledger issuerKey: Bytes<32>;
export sealed ledger organizerKey: Bytes<32>;
export sealed ledger eventId: Bytes<32>;

// A scalar eligibleRoot cannot contain a growing voter registry. The historic
// Merkle tree is the source of truth; its root is read by the TypeScript driver
// when it builds a voter membership witness.
export ledger eligibleVoters: HistoricMerkleTree<10, Bytes<32>>;
export ledger ballotCommitments: HistoricMerkleTree<10, Bytes<32>>;
export ledger spentNullifiers: Set<Bytes<32>>;
export ledger revealedCommitments: Set<Bytes<32>>;
export ledger tally: Map<Choice, Uint<32>>;
export ledger phase: Phase;
export ledger closed: Boolean;
export ledger issuedVoters: Counter;

witness issuerSecret(): Bytes<32>;
witness organizerSecret(): Bytes<32>;
witness voterSecret(): Bytes<32>;
witness voterPath(): MerkleTreePath<10, Bytes<32>>;
witness voterChoice(): Choice;
witness voteSalt(): Bytes<32>;
witness revealPath(): MerkleTreePath<10, Bytes<32>>;

circuit roleKey(domain: Bytes<32>, secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([domain, secret]);
}

constructor(
  initialIssuerSecret: Bytes<32>,
  initialOrganizerSecret: Bytes<32>,
  referendumEventId: Bytes<32>,
) {
  issuerKey = disclose(
    roleKey(pad(32, "referendum:issuer:"), initialIssuerSecret)
  );
  organizerKey = disclose(
    roleKey(pad(32, "referendum:organizer"), initialOrganizerSecret)
  );
  eventId = disclose(referendumEventId);

  tally.insert(Choice.YES, 0);
  tally.insert(Choice.NO, 0);
  tally.insert(Choice.ABSTAIN, 0);
  phase = Phase.COMMIT;
  closed = false;
}

// Camino A and Camino B both call this circuit. Only the issuer witness can
// add a commitment, so the bridge implementation can change without changing
// the voter circuit.
export circuit issue(commitment: Bytes<32>): [] {
  assert(
    roleKey(pad(32, "referendum:issuer:"), issuerSecret()) == issuerKey,
    "Only the eligibility issuer can issue commitments"
  );
  assert(phase == Phase.COMMIT, "Eligibility cannot be issued after commit phase");
  assert(!eligibleVoters.isFull(), "The eligibility tree is full");

  eligibleVoters.insert(disclose(commitment));
  issuedVoters.increment(1);
}

// The voter proves membership without revealing the commitment or secret.
// The nullifier is the only voter-derived value intentionally written to the
// public ledger, which prevents replay without linking the voter identity.
export circuit castVote(): [] {
  assert(phase == Phase.COMMIT, "Voting is not in the commit phase");

  const secret = voterSecret();
  const path = voterPath();
  const commitment = persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "referendum:commitment:"),
    secret,
  ]);

  assert(path.leaf == commitment, "The membership leaf does not match");
  assert(
    eligibleVoters.checkRoot(
      disclose(merkleTreePathRoot<10, Bytes<32>>(path))
    ),
    "The voter is not eligible for this referendum"
  );

  const nullifier = persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "referendum:nullifier:"),
    secret,
    eventId,
  ]);
  assert(
    !spentNullifiers.member(disclose(nullifier)),
    "This voter has already voted in this referendum"
  );

  spentNullifiers.insert(disclose(nullifier));

  // Choice and salt remain private in the commit transaction. Only the
  // persistent commitment is inserted into the historic tree.
  ballotCommitments.insert(
    persistentCommit<Choice>(voterChoice(), voteSalt())
  );
}

export circuit closeVote(): [] {
  assert(
    roleKey(pad(32, "referendum:organizer"), organizerSecret()) == organizerKey,
    "Only the organizer can close the referendum"
  );
  assert(phase == Phase.COMMIT, "The referendum is not in the commit phase");
  phase = Phase.REVEAL;
  closed = true;
}

// Revealing publishes only the selected bucket and the commitment, never the
// eligibility commitment or the voter nullifier. The path is supplied as a
// private witness and proves that the commitment was created during commit.
export circuit revealVote(choice: Choice, salt: Bytes<32>): [] {
  assert(phase == Phase.REVEAL, "Voting is not in the reveal phase");

  const commitment = persistentCommit<Choice>(choice, salt);
  const path = revealPath();
  assert(path.leaf == commitment, "The reveal does not match its commitment");
  assert(
    ballotCommitments.checkRoot(
      disclose(merkleTreePathRoot<10, Bytes<32>>(path))
    ),
    "The ballot commitment is not in this referendum"
  );
  assert(
    !revealedCommitments.member(disclose(commitment)),
    "This ballot has already been revealed"
  );

  revealedCommitments.insert(disclose(commitment));
  const currentTally = tally.lookup(disclose(choice));
  tally.insert(disclose(choice), currentTally + 1 as Uint<32>);
}

export circuit finalizeVote(): [] {
  assert(
    roleKey(pad(32, "referendum:organizer"), organizerSecret()) == organizerKey,
    "Only the organizer can finalize the referendum"
  );
  assert(phase == Phase.REVEAL, "The referendum is not in the reveal phase");
  phase = Phase.FINALIZED;
}
